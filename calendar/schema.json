{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://farsiui.com/calendar/schema.json",
  "title": "FarsiUI Calendar Data",
  "description": "Schemas for meta, fixed Jalali rules, and per-year holidays/events JSON under /calendar.",
  "$defs": {
    "localizedTitle": {
      "type": "object",
      "required": ["fa"],
      "properties": {
        "fa": { "type": "string", "minLength": 1 },
        "en": { "type": "string" }
      },
      "additionalProperties": false
    },
    "jalaliDate": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
      "description": "Jalali calendar date as YYYY-MM-DD (not Gregorian)."
    },
    "holidayItem": {
      "type": "object",
      "required": ["id", "date", "title", "isHoliday"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "date": { "$ref": "#/$defs/jalaliDate" },
        "ruleId": { "type": "string" },
        "title": { "$ref": "#/$defs/localizedTitle" },
        "isHoliday": { "type": "boolean" },
        "categories": {
          "type": "array",
          "items": { "type": "string" }
        },
        "notes": { "type": "string" }
      },
      "additionalProperties": false
    },
    "eventItem": {
      "type": "object",
      "required": ["id", "date", "title"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "date": { "$ref": "#/$defs/jalaliDate" },
        "title": { "$ref": "#/$defs/localizedTitle" },
        "isHoliday": { "type": "boolean", "const": false },
        "categories": {
          "type": "array",
          "items": { "type": "string" }
        },
        "notes": { "type": "string" }
      },
      "additionalProperties": false
    },
    "fixedRuleItem": {
      "type": "object",
      "required": ["id", "month", "day", "title", "isHoliday"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "month": { "type": "integer", "minimum": 1, "maximum": 12 },
        "day": { "type": "integer", "minimum": 1, "maximum": 31 },
        "title": { "$ref": "#/$defs/localizedTitle" },
        "isHoliday": { "type": "boolean" },
        "categories": {
          "type": "array",
          "items": { "type": "string" }
        },
        "notes": { "type": "string" }
      },
      "additionalProperties": false
    }
  },
  "oneOf": [
    {
      "title": "YearHolidays",
      "type": "object",
      "required": ["year", "schemaVersion", "items"],
      "properties": {
        "year": { "type": "integer", "minimum": 1300, "maximum": 1600 },
        "schemaVersion": { "type": "integer", "const": 1 },
        "dataVersion": { "type": "string" },
        "source": { "type": "string" },
        "coverage": { "type": "string" },
        "items": {
          "type": "array",
          "items": { "$ref": "#/$defs/holidayItem" }
        },
        "notes": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "additionalProperties": false
    },
    {
      "title": "YearEvents",
      "type": "object",
      "required": ["year", "schemaVersion", "items"],
      "properties": {
        "year": { "type": "integer", "minimum": 1300, "maximum": 1600 },
        "schemaVersion": { "type": "integer", "const": 1 },
        "dataVersion": { "type": "string" },
        "coverage": { "type": "string" },
        "items": {
          "type": "array",
          "items": { "$ref": "#/$defs/eventItem" }
        },
        "notes": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "additionalProperties": false
    },
    {
      "title": "FixedJalaliRules",
      "type": "object",
      "required": ["schemaVersion", "items"],
      "properties": {
        "schemaVersion": { "type": "integer", "const": 1 },
        "description": { "type": "string" },
        "items": {
          "type": "array",
          "items": { "$ref": "#/$defs/fixedRuleItem" }
        }
      },
      "additionalProperties": false
    }
  ]
}
